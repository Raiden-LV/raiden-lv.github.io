---
import Base from "../layouts/Base.astro";
import LinkButton from "../components/LinkButton.astro";
import DiscordStatus from "../components/DiscordStatus.astro";
import { profile } from "../data/profile";

// Prefix local asset paths with the base path so they work on GitHub Pages project sites.
const asset = (p: string) =>
  p.startsWith("/") ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${p}` : p;
---

<Base title={profile.name} description={profile.tagline}>
  <main>
    <header>
      <img src={asset(profile.avatar)} alt="" width="96" height="96" class="avatar" />
      <div>
        <h1>{profile.name}</h1>
        <p class="handle">{profile.handle}</p>
      </div>
      <p class="tagline">{profile.tagline}</p>
      <DiscordStatus userId={profile.discordId} />
    </header>

    <section aria-labelledby="now">
      <h2 id="now">Now</h2>
      <ul class="now">
        {profile.now.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby="about">
      <h2 id="about">About</h2>
      <p>{profile.about}</p>
    </section>

    <nav aria-label="Links">
      {profile.links.map((l) => <LinkButton {...l} />)}
    </nav>

    <footer>© {new Date().getFullYear()} {profile.name}</footer>
  </main>
</Base>

<style>
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .avatar {
    border-radius: 50%;
    border: 2px solid var(--border);
  }
  h1 {
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .handle {
    font-family: var(--font-mono);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .tagline {
    font-size: var(--text-lg);
  }
  h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  section p {
    color: var(--muted);
  }
  .now {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-1);
    color: var(--muted);
  }
  .now li::before {
    content: "→ ";
    color: var(--accent);
  }
  nav {
    display: grid;
    gap: var(--space-2);
  }
  footer {
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
